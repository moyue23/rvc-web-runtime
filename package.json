{
  "name": "rvc-web-runtime-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Monorepo for RVC-Web-Runtime - Browser-based RVC inference engine",
  "license": "MIT",
  "author": "RVC-Web-Runtime Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/rvc-web-runtime.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/app",
    "build": "npm run build --workspaces",
    "build:engine": "npm run build --workspace=packages/engine",
    "build:app": "npm run build --workspace=packages/app",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "format": "npm run format --workspaces",
    "format:check": "npm run format:check --workspaces"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@webgpu/types": "^0.1.69",
    "eslint": "^10.0.2",
    "globals": "^17.4.0",
    "prettier": "3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
