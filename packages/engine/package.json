{
  "name": "rvc-web-runtime",
  "version": "1.0.3",
  "type": "module",
  "description": "Browser-based RVC (Retrieval-based Voice Conversion) inference engine",
  "keywords": [
    "rvc",
    "voice-conversion",
    "ai",
    "onnx",
    "webgpu",
    "wasm",
    "audio",
    "machine-learning",
    "browser"
  ],
  "license": "MIT",
  "author": "moyue23 (https://github.com/moyue23)",
  "repository": {
    "type": "git",
    "url": "https://github.com/moyue23/rvc-web-runtime.git"
  },
  "homepage": "https://github.com/moyue23/rvc-web-runtime#readme",
  "bugs": {
    "url": "https://github.com/moyue23/rvc-web-runtime/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && vite build -c vite.config.worker.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier src --write",
    "format:check": "prettier src --check"
  },
  "dependencies": {
    "onnxruntime-web": "^1.24.2",
    "rvc-onnx-web": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.3.0",
    "vite-plugin-static-copy": "^3.4.0"
  }
}
